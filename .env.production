# docs https://cn.vitejs.dev/guide/env-and-mode.html#env-variables
# use: import.meta.env.VITE_XXX

# public path
VITE_PUBLIC_PATH = /

# vue router history mode : hash | history
VITE_ROUTER_HISTORY = hash

# 默认标题
VITE_DEFAULT_TITLE = "AI项目学习助手"
VITE_MENU_TYPE = "func" # func/menu

# 请求根路径 作用于/src/utils/http.js中
VITE_BASE_URL = '/lhlyvizApi'
VITE_BASE_URL_JPI = 

# 展示设置按钮
VITE_SHOW_SETTINGS = true
