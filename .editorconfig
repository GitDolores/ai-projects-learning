# https://editorconfig.org
# 编辑器代码格式规范 VSCode需要插件支持

# 表明是最顶层的配置文件，发现设为 true 时，才会停止查找.editorconfig 文件
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
# 在windows上执行:  git config --global core.autocrlf true，以便于git将拉下的代码中的lf转为crlf
end_of_line = crlf
insert_final_newline = true     # 去除行首任意空白字符
trim_trailing_whitespace = true # 始终在文件末尾插入一个新行

[*.md]
max_line_length = off
insert_final_newline = false
trim_trailing_whitespace = false
